@model List<CEDAlfaiaApp.Models.SaisirServicesModel>

<script type="text/javascript">
    function supprimerService(element) {
        var trParent = $(element).closest("tr[data-idService]");
        var isSupprime = trParent.find("input[id$=IsSupprime]");
        if (isSupprime.length > 0)
            isSupprime.val('true');
        trParent.slideUp('slow');
    }
    function ajouterService() {
        var trEmpty = $("#tableServices").find('tr[data-isEmpty=True]').first();
        if (trEmpty !== undefined && trEmpty.length > 0) {
            var newRow = trEmpty.clone(true);
            newRow.attr('data-isEmpty', 'False');
            newRow.find('input[id$=IsEmpty]').val('False');
            newRow.show();
            newRow.find("[name]").each(function () {
                var name = $(this).attr('name');
                var indexDebut = name.indexOf('[') + 1;
                var indexFin = name.indexOf(']');
                var index = $("#tableServices").find('tr[data-isEmpty]').length;
                $(this).attr('name', name.substring(0, indexDebut) + index + name.substring(indexFin, name.length));
            });
            $("#tableServices").append(newRow);
        }
    }

    function serviceAdd() {
        var $trLast = $("#tableServices").find('tr').last();
        if ($trLast !== undefined && $trLast.length > 0) {
            var newRow = $trLast.clone(true);
            var indexService = parseInt(newRow.find('input[role=IndexService]').val()) + 1;
            newRow.attr('data-isEmpty', 'False');
            newRow.attr('data-idService', '0');
            newRow.find('input[id$=IsEmpty]').val('False');
            newRow.show();

            $.ajax({
                url: '@Url.Action("ServicesAdd")?indexService=' + indexService,
                type: 'GET',
                dataType: 'html',
                context: { service: newRow },
                success: function (result) {
                    var $trService = this.service;

                    var $html = $(result);
                    $html.find('[name]').each(function () {
                        $(this).attr('name', 'Services' + $(this).attr('name'));
                    });

                    $trService.html($('<div>').append($html.clone()).html());

                    $("#tableServices").append(newRow);
			    }
		    });
        }
    }
    function serviceOnChange(element) {
        var $trService = $(element).closest('[data-idService]');
        var nameElement = $(element).attr('name');
        var idService = $trService.attr('data-idService');
        var quantite = $trService.find('[role=Quantite]').val();
        var libelle = $trService.find('[role=Libelle]').val();

        var prixTTC = $trService.find('[role=PrixClientTTC]').val();

        var indexService = $trService.find('[role=IndexService]').val();
        var isEmpty = $trService.find('[role=IsEmpty]').val();
        var isSupprime = $trService.find('[role=IsSupprime]').val();

        if (parseInt(prixTTC[prixTTC.length - 1]).toString() !== 'NaN') {
            $.ajax({
                url: '@Url.Action("ServicesChange")?idService=' + idService + '&libelle=' + libelle + '&quantite=' + quantite + '&prixTTC=' + prixTTC + '&indexService=' + indexService + '&isEmpty=' + isEmpty + '&isSupprime=' + isSupprime,
                type: 'GET',
                dataType: 'html',
                context: { service: $trService, nameElement: nameElement },
                success: function (result) {
                    var $trLigne = this.service;

                    var $html = $(result);
                    $html.find('[name]').each(function () {
                        $(this).attr('name', 'Services' + $(this).attr('name'));
                    });

                    $trLigne.html($('<div>').append($html.clone()).html());
                    SetCaretAtEnd($trLigne.find('[name="' + this.nameElement + '"]').first()[0]);//.focus();

                    piedFactureOnChange();
                }
            });
        }
    }
    function SetCaretAtEnd(elem) {
        var elemLen = elem.value.length;
        // For IE Only
        if (document.selection) {
            // Set focus
            elem.focus();
            // Use IE Ranges
            var oSel = document.selection.createRange();
            // Reset position to 0 & then set at end
            oSel.moveStart('character', -elemLen);
            oSel.moveStart('character', elemLen);
            oSel.moveEnd('character', 0);
            oSel.select();
        }
        else if (elem.selectionStart || elem.selectionStart == '0') {
            // Firefox/Chrome
            elem.selectionStart = elemLen;
            elem.selectionEnd = elemLen;
            elem.focus();
        } // if
    }
</script>

@{
    if (this.Model != null)
    {
        <table id="tableServices" class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th width="40%">Description</th>
                    <th width="11%">Quantité</th>
                    <th width="11%"></th>
                    <th width="17.5%"></th>
                    <th width="17.5%">Client</th>
                    <th width="3%"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < this.Model.Count(); i++)
                {
                    this.Model[i].IndexService = i;
                    var styleDisplay = this.Model[i].IsEmpty ? "none" : "";
                    <tr data-idService="@this.Model[i].IDService" data-isEmpty="@this.Model[i].IsEmpty" style="display:@styleDisplay">
                        @{
                            Html.RenderPartial("_LigneService", this.Model[i]);
                        }
                    </tr>
                 }
            </tbody>
        </table>
        <a class="pull-right" style="margin-right:10px;" href="#" onclick="serviceAdd(); return false;"><i class="fa fa-plus fa-2x text-success"></i></a>
     }
}
