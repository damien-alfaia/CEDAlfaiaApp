@model CEDAlfaiaApp.Models.SaisirServicesModel

@{

    <td>
        @Html.Hidden("[" + this.Model.IndexService + "].IndexService", this.Model.IndexService, new { role = "IndexService" })
        @Html.Hidden("[" + this.Model.IndexService + "].IsEmpty", this.Model.IsEmpty, new { role = "IsEmpty" })
        @Html.Hidden("[" + this.Model.IndexService + "].IDService", this.Model.IDService, new { role = "IDService" })
        @Html.Hidden("[" + this.Model.IndexService + "].IsSupprime", this.Model.IsSupprime, new { role = "IsSupprime" })
        @Html.TextArea("[" + this.Model.IndexService + "].Libelle", this.Model.Libelle, new { @class = "form-control", rows = "3", role = "Libelle", tabindex = 1 + (4 * this.Model.IndexService) })
    </td>
    <td>
        <div class="form-group">
            @Html.TextBox("[" + this.Model.IndexService + "].Quantite", this.Model.Quantite, new { @class = "form-control text-right", style = "margin-bottom:5px;", role = "Quantite", onchange = "serviceOnChange(this);", tabindex = 2 + (4 * this.Model.IndexService) })
        </div>
    </td>
    <td>
        
    </td>
    <td>

    </td>
    <td>
        <div class="form-group has-feedback">
            @Html.TextBox("[" + this.Model.IndexService + "].PrixClientHT", this.Model.PrixClientHT.ToString("n2"), new { @class = "form-control text-right", style = "margin-bottom:5px;padding-right:28px;", role = "PrixClientHT", disabled = true })
            <i class="form-control-feedback" style="font-size: 0.6em">€ HT</i>
        </div>
        <div class="form-group has-feedback">
            @Html.TextBox("[" + this.Model.IndexService + "].PrixClientTTC", this.Model.PrixClientTTC.ToString("n2"), new { @class = "form-control text-right", onchange = "serviceOnChange(this);", style = "margin-bottom:5px;padding-right:30px;", role = "PrixClientTTC" })
            <i class="form-control-feedback" style="font-size: 0.6em">€ TTC</i>
        </div>
        <span class="text-muted pull-right" role="BeneficeTotal">@(((this.Model.PrixClientTTC) * this.Model.Quantite) + " €")</span>
    </td>
    <td>
        <a href="#" onclick="supprimerService(this); return false;"><i class="fa fa-times fa-2x text-danger"></i></a>
    </td>
}