@model List<CEDAlfaiaApp.Models.FactureModel>
@{
    ViewBag.Title = "Liste des factures annulées";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    $(function () {
        $('#tableFactures').DataTable({
            'paging': true,
            'lengthChange': true,
            'searching': true,
            'ordering': true,
            'info': true,
            'autoWidth': true,
            'aoColumns': [
                null,
                { "sType": "date-uk" },
                null,
                null,
                null,
                { "sType": "num-fmt" },
                null
            ],
            'language': {
                "lengthMenu": "Afficher _MENU_ factures par page",
                "zeroRecords": "Aucune facture trouvée",
                "info": "Page _PAGE_ sur _PAGES_",
                "infoEmpty": "Aucune facture trouvée",
                "paginate": {
                    "previous": "Précédent",
                    "next": "Suivant"
                },
                "search": "Rechercher"
            }
        });
    })

    jQuery.extend(jQuery.fn.dataTableExt.oSort, {
        "date-uk-pre": function (a) {
            var ukDatea = a.split('/');
            return (ukDatea[2] + ukDatea[1] + ukDatea[0]) * 1;
        },

        "date-uk-asc": function (a, b) {
            return ((a < b) ? -1 : ((a > b) ? 1 : 0));
        },

        "date-uk-desc": function (a, b) {
            return ((a < b) ? 1 : ((a > b) ? -1 : 0));
        }
    });

     function repasserEnFacture(element) {
        if (confirm("Voulez-vous repasser cette pièce de vente en facture ? ")) {
            var idFacture = $(element).closest("[data-idFacture]").attr('data-idFacture');
            $.ajax({
                url: '@Url.Action("RepasserEnFacture")',
                data: JSON.stringify({ idFacture: idFacture }),
                contentType: 'application/json; charset=utf-8',
                context: { idFacture: idFacture },
                type: 'POST',
                success: function (result) {
                    if (result == "OK")
                        $("tr[data-idFacture=" + this.idFacture + "]").remove();
                    else
                        alert(result);
                },
                error: function (err) {
                    alert(err);
                }
            });
        }
    }
</script>

<section class="content-header">
    <h1>
        Liste des factures annulées
    </h1>
    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> CEDAlfaia</a></li>
        <li>Factures annulées</li>
    </ol>
</section>

<section class="content">
    @{
        if (this.Model != null && this.Model.Any())
        {
            <div class="box box-danger hidden-xs hidden-sm">
                <div class="box-header">
                    <h3 class="box-title">Liste des factures annulées</h3>
                </div>
                <!-- /.box-header -->
                <div class="box-body">
                    <table id="tableFactures" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Numéro</th>
                                <th>Date</th>
                                <th>Client</th>
                                <th>Voiture</th>
                                <th>Motif</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in this.Model)
                {
                                <tr data-idFacture="@d.ID">
                                    <td>
                                        @d.Numero
                                    </td>
                                    <td>
                                        @d.Date.ToShortDateString()
                                    </td>
                                    <td>
                                        @Html.DisplayFor(m => d.Client, "Client")
                                    </td>
                                    <td>
                                        @Html.DisplayFor(m => d.Voiture, "Voiture")
                                    </td>
                                    <td>
                                        @d.MotifAnnulation
                                    </td>
                                    <td>
                                        @(d.Total.ToString("F") + "€")
                                    </td>
                                    <td>
                                        <span class="btn-group pull-right">
                                            <button type="button" class="btn btn-md btn-default dropdown-toggle" data-toggle="dropdown">
                                                <span class="caret"></span>
                                            </button>
                                            <ul class="dropdown-menu" role="menu">
                                                <li>
                                                    <a href="#" onclick="repasserEnFacture(this);"><i class="fa fa-times"></i>&nbsp;Repasser en facture</a>
                                                </li>
                                            </ul>
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Numéro</th>
                                <th>Date</th>
                                <th>Client</th>
                                <th>Voiture</th>
                                <th>Motif</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <!-- /.box-body -->
            </div>
        }
    }
    <div style="display:block;margin-bottom:50px;">
        @Html.ActionLink("Afficher les factures", "Liste", null, new { @class = "btn btn-success pull-right" })
    </div>
</section>
