@model int

@Html.DevExpress().Menu(
        settings =>
        {

            settings.Name = "menuFacture" + Model;
            settings.ShowPopOutImages = DefaultBoolean.True;
            //settings.EnableClientSideAPI = true;
            //settings.ClientSideEvents.ItemClick = "menuDevis_menuItemClick";
            settings.Items.Add(item =>
            {
                item.Text = "Actions";
                item.Items.Add(subItem =>
                {
                    subItem.Text = "Ouvrir";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "Saisir", identifiant = Model, typeId = 0 });
                });
                item.Items.Add(subItem =>
                {
                    subItem.Text = "Imprimer";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "Editer", idFacture = Model });
                });

                item.Items.Add(subItem =>
                {
                    subItem.Text = "Payé en especes";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "Paye", idFacture = Model, modePaiement = 0 });
                });
                item.Items.Add(subItem =>
                {
                    subItem.Text = "Payé en CB";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "Paye", idFacture = Model, modePaiement = 2 });
                });
                item.Items.Add(subItem =>
                {
                    subItem.Text = "Payé en chèque";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "Paye", idFacture = Model, modePaiement = 1 });
                });
                item.Items.Add(subItem =>
                {
                    subItem.Text = "Valider";
                    subItem.Name = "Valider";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "ValiderFacture", idFacture = Model });
                });
                item.Items.Add(subItem =>
                {
                    subItem.Text = "Annuler";
                    subItem.Name = "Annuler";
                    subItem.NavigateUrl = DevExpressHelper.GetUrl(new { Controller = "Factures", Action = "Annuler", idFacture = Model });
                });
            });
        }).GetHtml()