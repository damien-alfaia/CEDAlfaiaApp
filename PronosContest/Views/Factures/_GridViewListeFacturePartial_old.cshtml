@model CEDAlfaiaApp.Models.SearchPieceVenteWithPiecesVenteModel

@{
    var grid = Html.DevExpress().GridView(settings =>
    {
        settings.Name = "GridViewListeFacture";
        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CallbackRouteValues = new { Controller = "Factures", Action = "GridViewListeFacturePartial", idClient = this.Model.Search.ClientID, dateDebut = this.Model.Search.DateDebut, dateFin = this.Model.Search.DateFin };
        settings.SettingsBehavior.AllowGroup = true;
        settings.SettingsBehavior.FilterRowMode = GridViewFilterRowMode.Auto;
        settings.Settings.ShowColumnHeaders = true;
        settings.Settings.ShowFooter = true;
        settings.Settings.ShowGroupPanel = true;
        settings.EnableRowsCache = true;
        settings.SettingsCookies.Enabled = true;
        settings.ClientLayout = (s, e) =>
        {
            switch (e.LayoutMode)
            {
                case ClientLayoutMode.Loading:
                    if (Session["LayoutFactures"] != null)
                    {
                        e.LayoutData = Session["LayoutFactures"].ToString();
                    }
                    break;
                case ClientLayoutMode.Saving:
                    Session["LayoutFactures"] = e.LayoutData;
                    break;
            }
        };

        settings.SettingsAdaptivity.AdaptivityMode = GridViewAdaptivityMode.HideDataCells;
        settings.SettingsAdaptivity.AllowOnlyOneAdaptiveDetailExpanded = true;
        settings.EditFormLayoutProperties.SettingsAdaptivity.AdaptivityMode = FormLayoutAdaptivityMode.Off;
        settings.EditFormLayoutProperties.SettingsAdaptivity.SwitchToSingleColumnAtWindowInnerWidth = 100;
        settings.SettingsBehavior.AllowEllipsisInText = true;

        settings.SettingsExport.EnableClientSideExportAPI = true;
        settings.SettingsExport.ExcelExportMode = DevExpress.Export.ExportType.WYSIWYG;
        settings.Toolbars.Add(t =>
        {
            t.EnableAdaptivity = true;
            t.Items.Add(GridViewToolbarCommand.ExportToPdf);
            t.Items.Add(GridViewToolbarCommand.ExportToXls);
            //t.Items.Add(GridViewToolbarCommand.ExportToXlsx);
            t.Items.Add(GridViewToolbarCommand.ExportToDocx);
        });
        settings.SettingsExport.RenderBrick = (sender, e) =>
        {
            if (e.RowType == GridViewRowType.Data && e.VisibleIndex % 2 == 0)
                e.BrickStyle.BackColor = System.Drawing.Color.FromArgb(0xEE, 0xEE, 0xEE);
        };

        settings.Width = System.Web.UI.WebControls.Unit.Percentage(100);
        settings.CommandColumn.Visible = false;
        settings.KeyFieldName = "ID";

        settings.SettingsPager.Visible = true;
        settings.Settings.ShowFilterRow = true;
        settings.SettingsBehavior.AllowSelectByRowClick = true;

        settings.ClientSideEvents.RowDblClick = "function(s, e) { s.GetRowValues(e.visibleIndex, 'ID', function (value) { ouvrirFacture(value); }); }";

        settings.Columns.Add(column => {
            column.FieldName = "NumFacture";
            column.Caption = "N° facture";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(100);
            column.AdaptivePriority = 2;
            column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
        });
        settings.Columns.Add(column => {
            column.FieldName = "DateFacture";
            column.Caption = "Date";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(100);
            column.PropertiesEdit.DisplayFormatString = "dd/MM/yyyy";
            column.AdaptivePriority = 2;
        });
        settings.Columns.Add(column => {
            column.FieldName = "Client";
            column.Caption = "Client";
            column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
            column.AdaptivePriority = 1;
        });
        settings.Columns.Add(column => {
            column.FieldName = "Voiture";
            column.Caption = "Voiture";
            column.Settings.AutoFilterCondition = AutoFilterCondition.Contains;
            column.AdaptivePriority = 4;
        });
        settings.Columns.Add(column => {
            column.FieldName = "Kilometrage";
            column.Caption = "Kilométrage";
            column.AdaptivePriority = 4;
        });
        settings.Columns.Add(column => {
            column.FieldName = "TotalHT";
            column.Caption = "Total HT";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(100);
            column.PropertiesEdit.DisplayFormatString = "c2";
            column.AdaptivePriority = 3;
        });
        settings.Columns.Add(column => {
            column.FieldName = "TotalTTC";
            column.Caption = "Total TTC";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(100);
            column.PropertiesEdit.DisplayFormatString = "c2";
            column.AdaptivePriority = 1;
        });
        settings.Columns.Add(column => {
            column.FieldName = "BeneficeTTC";
            column.Caption = "Bénéfice TTC";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(100);
            column.PropertiesEdit.DisplayFormatString = "c2";
            column.AdaptivePriority = 2;
        });
        settings.Columns.Add(column => {
            column.FieldName = "ResteAPayer";
            column.Caption = "Reste à payer";
            column.Width = System.Web.UI.WebControls.Unit.Pixel(100);
            column.PropertiesEdit.DisplayFormatString = "c2";
            column.AdaptivePriority = 2;
        });
        //settings.Columns.Add(column => { column.FieldName = "Paye"; column.Caption = "Paiement"; });
        settings.Columns.Add(column => { column.FieldName = "Etat"; column.Caption = "Etat"; });
        settings.Columns.Add(column =>
        {
            column.Caption = "Paiement";
            column.AdaptivePriority = 3;
            column.SetDataItemTemplateContent(c =>
            {
                var objectList = c.Grid.GetRow(c.VisibleIndex);
                if (objectList != null)
                {
                    Type myType = objectList.GetType();
                    IList<System.Reflection.PropertyInfo> props = new List<System.Reflection.PropertyInfo>(myType.GetProperties());

                    System.Reflection.PropertyInfo prop = props.Where(p => p.Name == "Paye").FirstOrDefault();
                    if (prop != null)
                    {
                        string paye = prop.GetValue(objectList, null).ToString();
                        string cssClass = "label-primary";
                        switch (paye)
                        {
                            case "Payé":
                                cssClass = "label-success";
                                break;
                            case "A payer":
                                cssClass = "label-danger";
                                break;
                            case "Non terminé":
                                cssClass = "label-warning";
                                break;
                        }
                        string html = "<span class=\"label " + cssClass + "\">" + paye + "</span>";
                        ViewContext.Writer.Write(html);
                    }
                }
            });
        });
        settings.Columns.Add(column =>
        {
            column.Width = System.Web.UI.WebControls.Unit.Pixel(80);
            column.AdaptivePriority = 1;
            column.SetDataItemTemplateContent(c =>
            {
                var objectList = c.Grid.GetRow(c.VisibleIndex);
                if (objectList != null)
                {
                    Type myType = objectList.GetType();
                    IList<System.Reflection.PropertyInfo> props = new List<System.Reflection.PropertyInfo>(myType.GetProperties());

                    System.Reflection.PropertyInfo prop = props.Where(p => p.Name == "ID").FirstOrDefault();
                    if (prop != null)
                    {
                        object id = prop.GetValue(objectList, null);
                        ViewContext.Writer.Write(Html.Partial("Menu", id));
                    }
                }
            });
        });

        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "BeneficeTTC").DisplayFormat = "<b>{0:c2}</b>";
        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "TotalTTC").DisplayFormat = "<b>{0:c2}</b>";
        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "TotalHT").DisplayFormat = "<b>{0:c2}</b>";
        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Sum, "ResteAPayer").DisplayFormat = "<b>{0:c2}</b>";
        settings.TotalSummary.Add(DevExpress.Data.SummaryItemType.Count, "NumFacture").DisplayFormat = "<b>{0}</b>";

        settings.PreRender = (sender, e) =>
        {
            ASPxGridView gridSender = (ASPxGridView)sender;
            gridSender.ExpandAll();
        };
        
        settings.ClientSideEvents.Init = "function(s, e) { s.PerformCallback(); }";
        settings.SettingsPager.PageSize = 30;
        settings.SettingsPager.NumericButtonCount = 6;
        settings.Styles.Cell.Wrap = DefaultBoolean.False;
    });
    if (ViewData["EditError"] != null)
    {
        grid.SetEditErrorText((string)ViewData["EditError"]);
    }
}
@grid.BindToLINQ(string.Empty, string.Empty, (s, e) =>
{
    e.KeyExpression = "ID";
    e.QueryableSource = this.Model.PiecesVente.Select(d => new { ID = d.ID, NumFacture = d.NumFacture, Client = d.Client.Nom + " " + d.Client.Prenom, Voiture = d.Voiture.Modele.Marque.Libelle + " " + d.Voiture.Modele.Libelle, BeneficeTTC = d.BeneficeTTC, DateFacture = d.DateFacture, Kilometrage = d.Kilometrage, MontantTVA = d.MontantTVA, Remise = d.Remise, ResteAPayer = d.ResteAPayer, TotalHT = d.TotalHT, TotalTTC = d.TotalTTC, Paye = (d.ResteAPayer == d.TotalTTC ? "A payer" : (d.ResteAPayer == 0 ? "Payé" : "Non terminé")), Etat = (!d.IsValide ? "En attente de validation" : (d.IsFactureAnnule ? "Annulé" : (d.IsEnvoyeComptable ? "Envoyé au comptable" : "Validé"))) });
}, (s, e) =>
{
    var ex = e.Exception;

}).GetHtml()