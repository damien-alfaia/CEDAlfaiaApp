                                //subItems.AddSimpleFor(m => m.Remise).Editor(e => e.NumberBox().Option("data-role","Remise").Min(0).Max(100).Format("#0%").OnChange("updatePiedFacture"));
                                subItems.AddSimpleFor(m => m.TotalHT).Editor(e => e.NumberBox().ID("TotalHT").Format("#0.00€"));
                                subItems.AddSimpleFor(m => m.MontantTVA).Editor(e => e.NumberBox().ID("MontantTVA").Format("#0.00€"));
                                subItems.AddSimpleFor(m => m.TotalTTC).Editor(e => e.NumberBox().ID("TotalTTC").Format("#0.00€"));
                            });
                            tab.Add().Title("Paiements").ColCount(1).Items(subItems =>
                            {
                                subItems.AddSimple().Label(lb => lb.Text("Paiements")).Template(@<text>
        @(
                                        Html.DevExtreme().DataGrid<CEDAlfaiaApp.Models.SaisirPaiementPieceVenteModel>()
                                        .ID("gridPaiements")
                                        .DataSource(this.Model.Paiements)
                                        .Editing(ed =>
                                        {
                                            ed.AllowAdding(true).AllowUpdating(true).AllowDeleting(true).Mode(GridEditMode.Cell);
                                            ed.Texts(t =>
                                            {
                                                t.ConfirmDeleteMessage("Voulez-vous vraiment supprimer ce paiement ?");
                                                t.ConfirmDeleteTitle("Suppression de paiement");
                                                t.DeleteRow("Supprimer");
                                            });
                                        })
                                        .RemoteOperations(false)
                                        .Summary(s => s.TotalItems(totItems =>
                                        {
                                            totItems.AddFor(m => m.Montant).SummaryType(SummaryType.Sum).ValueFormat(v => v.Precision(2).Type(Format.FixedPoint)).DisplayFormat("{0}€");
                                        }))
                                        .Columns(columns =>
                                        {
                                            columns.AddFor(m => m.Date)
                                                .DataType(GridColumnDataType.Date)
                                                .Format(formatter =>
                                                {
                                                    formatter.Formatter("formaterDate");
                                                    formatter.Parser("parserDate");
                                                })
                                                .Caption("Date");
                                            columns.AddFor(m => m.TypePaiement)
                                                .Lookup(m => m.DataSource(typesPaiement).DisplayExpr("Libelle").ValueExpr("Valeur"))
                                                .Caption("Type de paiement");
                                            columns.AddFor(m => m.Montant)
                                                .Caption("Montant")
                                                .DataType(GridColumnDataType.Number)
                                                .Width(100);
                                        })
        )
                                </text>);
                            });
                            tab.Add().Title("Rendez-vous").ColCount(4).Items(subItems =>
                            {
                                subItems.AddSimpleFor(m => m.RendezVous.Sujet).Editor(ed => ed.TextBox()).ColSpan(2);
                                subItems.AddSimpleFor(m => m.RendezVous.Debut).Editor(ed => ed.DateBox().Type(DateBoxType.DateTime).Width("100%").DisplayFormat("dd/MM/yyyy HH:mm"));
                                subItems.AddSimpleFor(m => m.RendezVous.Fin).Editor(ed => ed.DateBox().Type(DateBoxType.DateTime).Width("100%").DisplayFormat("dd/MM/yyyy HH:mm"));
                                subItems.AddSimpleFor(m => m.RendezVous.Commentaire).Editor(ed => ed.TextArea()).ColSpan(4);
                            });
                            /*tab.Add().Title("Devis fournisseur").Items(subItems =>
                            {
                                subItems.AddSimpleFor(m => m.)
                            });
                            tab.Add().Title("BL fournisseur").Items(subItems =>
                            {

                            });*/
                        });
                })
            .LabelLocation(FormLabelLocation.Top)
            .FormData(Model)
            )
        }
        <div style="text-align:right;margin-top:10px;">
            @Html.DevExtreme().Button().Text("Annuler").Icon("back").OnClick("goToLastPage")
            @Html.DevExtreme().Button().Text("Enregistrer").Icon("save").OnClick("clickHandler").UseSubmitBehavior(false).Type(ButtonType.Success)
        </div>
    }
</div>


@using (Html.DevExtreme().NamedTemplate("EmbeddedDataGridClient"))
{
    @(Html.DevExtreme().DataGrid()
        .ID("embedded-datagrid-voitures")
        .DataSource(new JS(@"component.option(""dataSource"")"))
        .Columns(columns =>
        {
            columns.Add().DataField("Client");
            columns.Add().DataField("Marque");
            columns.Add().DataField("Modele");
            columns.Add().DataField("Immatriculation");
            columns.Add().DataField("Libelle").Visible(false);
        })
        .HoverStateEnabled(true)
        .Paging(p => p.PageSize(10))
        .FilterRow(f => f.Visible(true))
        .Scrolling(s => s.Mode(GridScrollingMode.Infinite))
        .Height(345)
        .Selection(s => s.Mode(SelectionMode.Single))
        .SelectedRowKeys(new JS(@"[component.option(""value"")]"))
        .OnSelectionChanged(@<text>
            function(selectedItems) {
            var keys = selectedItems.selectedRowKeys;
            component.option("value", keys);
            }
        </text>)
    )
}


