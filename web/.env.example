# =============================================================================
# CEDAlfaiaApp v3 — Variables d'environnement
# =============================================================================
# Copier ce fichier vers .env.local et remplir les valeurs.
# Récupérer les valeurs depuis : Supabase Dashboard → Project Settings → API
# =============================================================================

# URL publique du projet Supabase (visible côté client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anon publique (visible côté client — protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé service_role (NE JAMAIS commiter, jamais exposée côté client)
# Utilisée uniquement pour les scripts admin (ETL, migrations one-shot)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Code d'inscription requis sur la page /signup.
# Variable serveur (jamais NEXT_PUBLIC_*). Choisir une chaîne aléatoire forte.
# Pour générer : openssl rand -base64 24 | tr -d '/=+'
SIGNUP_CODE=changez-moi
