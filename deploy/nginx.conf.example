# Exemple de vhost nginx pour CEDAlfaiaApp v3
# À placer dans /etc/nginx/sites-available/cedalfaia.conf
# Symlink: sudo ln -s /etc/nginx/sites-available/cedalfaia.conf /etc/nginx/sites-enabled/
# Test: sudo nginx -t && sudo systemctl reload nginx
# Cert HTTPS: sudo certbot --nginx -d garage.exemple.fr

server {
    server_name garage.exemple.fr;

    # Taille max upload (utile pour les documents joints aux devis)
    client_max_body_size 15M;

    # Logs
    access_log /var/log/nginx/cedalfaia-access.log;
    error_log  /var/log/nginx/cedalfaia-error.log;

    # Gzip pour les assets statiques (Next sert déjà du brotli/gzip mais ceinture+bretelles)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_min_length 1000;

    # Reverse proxy vers Next.js standalone (PM2)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }

    listen 80;
    # Après certbot, ce bloc deviendra :
    # listen 443 ssl http2;
    # ssl_certificate /etc/letsencrypt/live/garage.exemple.fr/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/garage.exemple.fr/privkey.pem;
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
