# =============================================================================
# Variables pour deploy/docker-compose.yml
# =============================================================================
# Copier vers deploy/.env sur le VPS et remplir.
# Ce fichier est dans .gitignore (jamais commité).
# =============================================================================

# Domaine sur lequel Traefik exposera l'app
DOMAIN=toniauto.dalfaia.fr

# Credentials Supabase prod (les NEXT_PUBLIC_* sont inlinés au build)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Code d'inscription requis sur la page /signup. Variable serveur uniquement.
# À générer avec : openssl rand -base64 24 | tr -d '/=+'
SIGNUP_CODE=changez-moi
