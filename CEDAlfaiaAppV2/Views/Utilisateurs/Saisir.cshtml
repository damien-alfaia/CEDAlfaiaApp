@model CEDAlfaiaApp.Models.UtilisateurModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="content-header">
    <h1>
        Saisir un utilisateur
    </h1>
    <ol class="breadcrumb">
        <li><a href="#"><i class="fa fa-dashboard"></i> CEDAlfaia</a></li>
        <li><a href="@Url.Action("Liste", "Utilisateurs")">Utilisateurs</a></li>
        <li class="active">Saisir un utilisateur</li>
    </ol>
</section>

@{
    string titleFormulaire = "Nouvel utilisateur";
    if (this.Model != null && this.Model.ID > 0)
    {
        titleFormulaire = this.Model.Prenom + " " + this.Model.Nom;
    }
}

<section class="content">
    <div class="box box-danger">
        <div class="box-header with-border">
            <h3 class="box-title">@titleFormulaire</h3>
        </div>

        @Html.ValidationSummary(false, "", new { @style = "color:red;" })
        @using (Html.BeginForm())
        {
            @Html.HiddenFor(m => m.ID)
            <div class="box-body">
                <div class="form-group">
                    @Html.LabelFor(m => m.Entreprise)
                    @Html.DropDownListFor(m => m.Entreprise.ID, (List<SelectListItem>)ViewBag.EntreprisesListItems, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Nom)
                    @Html.TextBoxFor(m => m.Nom, new { @class = "form-control", placeholder = "Nom" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Prenom)
                    @Html.TextBoxFor(m => m.Prenom, new { @class = "form-control", placeholder = "Prénom" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.AdresseMail)
                    @Html.TextBoxFor(m => m.AdresseMail, new { @class = "form-control", placeholder = "Email" })
                </div>
                @Html.HiddenFor(m => m.MotDePasse)
                <div class="form-group">
                    @Html.LabelFor(m => m.Role)
                    @Html.DropDownListFor(m => m.Role, new List<SelectListItem> { new SelectListItem() { Text = "Administrateur", Value = "1" }, new SelectListItem() { Text = "Secrétaire", Value = "2" }, new SelectListItem() { Text = "Technicien", Value = "3" } }, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.EditorFor(m => m.Adresse, "Adresse")
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Commentaire)
                    @Html.TextAreaFor(m => m.Commentaire, new { @class = "form-control", placeholder = "Commentaire" })
                </div>
            </div>

            <div class="box-footer">
                <button class="btn btn-md btn-default" type="reset">Annuler</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        }
    </div>
</section>
