<html>
<head>
    <meta charset="utf-8" />
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0' name='viewport' />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/Content/js")
    <script type="text/javascript" src="https://cdn.datatables.net/plug-ins/1.10.16/sorting/date-eu.js"></script>
    <meta content="/img/icone.png" itemprop="image">
    <link href="/img/favicon.ico" rel="shortcut icon">
    @Html.DevExpress().GetStyleSheets(
        new StyleSheet { ExtensionSuite = ExtensionSuite.NavigationAndLayout, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.Editors, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.HtmlEditor, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.GridView, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.PivotGrid, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.Chart, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.Report, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.Scheduler, Theme = "Metropolis" },
        new StyleSheet { ExtensionSuite = ExtensionSuite.TreeList, Theme = "Metropolis" }
    )
    @Html.DevExpress().GetScripts(
        new Script { ExtensionSuite = ExtensionSuite.NavigationAndLayout },
        new Script { ExtensionSuite = ExtensionSuite.Editors },
        new Script { ExtensionSuite = ExtensionSuite.GridView },
        new Script { ExtensionSuite = ExtensionSuite.Report }
    )

    <script type="text/javascript">
        function chargerComposants() {
            $('[data-role=datetimepicker]').datetimepicker({
                format: 'DD/MM/YYYY',
                locale: 'fr'
            });

            $('[data-role=timepicker]').datetimepicker({
                format: 'HH:mm',
                locale: 'fr'
            });
        }
        $(document).ready(function () {
            chargerComposants();
        });
    </script>
    <style>
        .table-striped > tbody > tr:nth-of-type(odd) {
            background-color: rgba(255, 0, 0, 0.30);
        }

        .table-striped > tbody > tr:nth-of-type(even) {
            background-color: white;
        }
    </style>
</head>
@{
    CEDAlfaiaApp.DAL.Parametrage.Parametrage parametrage = new CEDAlfaiaApp.DAL.Parametrage.Parametrage();
    var ctx = Request.GetOwinContext();
    var authManager = ctx.Authentication;
    string nomComplet = "";
    CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole roleUtilisateur = CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole.Administrateur;
    if (authManager.User != null)
    {
        string idUser = authManager.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Sid).Select(c => c.Value).SingleOrDefault();
        string prenom = authManager.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Name).Select(c => c.Value).SingleOrDefault();
        string nom = authManager.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Surname).Select(c => c.Value).SingleOrDefault();
        string role = authManager.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).SingleOrDefault();
        roleUtilisateur = (CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole)Int32.Parse(role);
        nomComplet = prenom + " " + nom;

        int id = 0;
        int.TryParse(idUser, out id);
        if (id > 0)
        {
            parametrage = CEDAlfaiaApp.BLL.CEDAlfaiaAppWebService.GetService().ParametrageService.GetParametrageUtilisateur(id);
            CEDAlfaiaApp.Code.Impression.Parametrage = parametrage;
        }
    }
}
@{
    var nomEntreprise = "ALFAIA";
    string imageSrc = null;
    if (parametrage != null && parametrage.NomEntreprise != null)
    {
        nomEntreprise = parametrage.NomEntreprise;

        if (parametrage.Logo != null)
        {
            string imageBase64 = Convert.ToBase64String(parametrage.Logo);
            imageSrc = string.Format("data:image/png;base64,{0}", imageBase64);
        }
    }
}
<body class="hold-transition skin-red sidebar-mini">
    <div class="wrapper">
        <header class="main-header">
            <!-- Logo -->
            <a href="#" class="logo">
                <span class="logo-lg">
                    @{
                        if (imageSrc != null)
                        {
                            <img src="@imageSrc" width="30" height="30" />
                        }
                    }
                    <b>@nomEntreprise</b>
                </span>
            </a>
            <!-- Header Navbar: style can be found in header.less -->
            <nav class="navbar navbar-static-top">
                <!-- Sidebar toggle button-->
                <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button">
                    <span class="sr-only">Toggle navigation</span>
                </a>
                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        <li class="dropdown messages-menu">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                <i class="fa fa-envelope-o"></i>
                                <span class="label label-success">4</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li class="header">You have 4 messages</li>
                                <li>
                                    <!-- inner menu: contains the actual data -->
                                    <ul class="menu">
                                        <li>
