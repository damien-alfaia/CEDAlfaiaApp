        </header>
        <!-- Left side column. contains the logo and sidebar -->
        <aside class="main-sidebar">
            <!-- sidebar: style can be found in sidebar.less -->
            <section class="sidebar">
                <!-- search form -->
                <form action="#" method="get" class="sidebar-form">
                    <div class="input-group">
                        <input type="text" name="q" class="form-control" placeholder="Rechercher...">
                        <span class="input-group-btn">
                            <button type="submit" name="search" id="search-btn" class="btn btn-flat">
                                <i class="fa fa-search"></i>
                            </button>
                        </span>
                    </div>
                </form>
                <!-- /.search form -->
                <!-- sidebar menu: : style can be found in sidebar.less -->
                <ul class="sidebar-menu" data-widget="tree">
                    <li class="header">MENU</li>
                    @{
                        var controleur = "";
                        if (Request.RawUrl.Split('/').Length > 1)
                        {
                            controleur = Request.RawUrl.Split('/')[1];
                        }
                        var activeTableauDeBord = "";
                        var activeClient = "";
                        var activeDevis = "";
                        var activeEntreprises = "";
                        var activeParametrage = "";
                        var activeUtilisateurs = "";
                        var activeFactures = "";
                        var activeFinancier = "";
                        var activeComptable = "";
                        switch (controleur)
                        {
                            case "":
                                activeTableauDeBord = "active";
                                break;
                            case "Clients":
                                activeClient = "active";
                                break;
                            case "Devis":
                                activeDevis = "active";
                                break;
                            case "Parametrage":
                                activeParametrage = "active";
                                break;
                            case "Entreprise":
                                activeEntreprises = "active";
                                break;
                            case "Utilisateurs":
                                activeUtilisateurs = "active";
                                break;
                            case "Factures":
                                activeFactures = "active";
                                break;
                            case "Financier":
                                activeFinancier = "active";
                                break;
                            case "Comptable":
                                activeComptable = "active";
                                break;
                        }
                    }
                    <li class="@activeTableauDeBord">
                        <a href="@Url.Action("Index", "Home" )">
                            <i class="fa fa-dashboard"></i> <span>Tableau de bord</span>
                        </a>
                    </li>
                    @{
                        switch (roleUtilisateur)
                        {
                            case CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole.SuperAdmin:
                                <li class="@activeEntreprises">
                                    <a href="@Url.Action("Liste", "Entreprise" )">
                                        <i class="fa fa-building-o"></i> <span>Entreprises</span>
                                    </a>
                                </li>
                                <li class="@activeUtilisateurs">
                                    <a href="@Url.Action("Liste", "Utilisateurs" )">
                                        <i class="fa fa-users"></i> <span>Utilisateurs</span>
                                    </a>
                                </li>
                                break;
                            case CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole.Administrateur:
                                <li class="@activeClient">
                                    <a href="@Url.Action("Liste", "Clients" )">
                                        <i class="fa fa-users"></i> <span>Clients</span>
                                    </a>
                                </li>
                                <li class="treeview">
                                    <a href="#">
                                        <i class="fa fa-calendar"></i> <span>Agenda</span>
                                    </a>
                                </li>
                                <li class="@activeDevis">
                                    <a href="@Url.Action("Liste", "Devis" )">
                                        <i class="fa fa-file-text-o"></i> <span>Devis</span>
                                    </a>
                                </li>
                                <li class="@activeFactures">
                                    <a href="@Url.Action("Liste", "Factures" )">
                                        <i class="fa fa-file-text-o"></i> <span>Factures</span>
                                    </a>
                                </li>
                                <li class="@activeFinancier">
                                    <a href="@Url.Action("Liste", "Financier" )">
                                        <i class="fa fa-money"></i> <span>Financier</span>
                                    </a>
                                </li>
                                <li class="@activeComptable">
                                    <a href="@Url.Action("Liste", "Comptable" )">
                                        <i class="fa fa-envelope"></i> <span>Comptable</span>
                                    </a>
                                </li>
                                <li class="@activeParametrage">
                                    <a href="@Url.Action("Saisir", "Parametrage" )">
                                        <i class="fa fa-cog"></i> <span>Paramétrage</span>
                                    </a>
                                </li>
                                break;
                            case CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole.Secretaire:
                                break;
                            case CEDAlfaiaApp.DAL.Authentification.CompteUtilisateurRole.Technicien:
                                break;
                        }
                    }
                </ul>
            </section>
            <!-- /.sidebar -->
        </aside>
        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            @RenderBody()
        </div>
        <!-- /.content-wrapper -->
        <footer class="main-footer">
            <div class="pull-right hidden-xs">
                <b>Version</b> 2.0.0
            </div>
            <strong>Copyright &copy; 2017-2018 <a href="">CEDAlfaia</a>.</strong> All rights
            reserved.
        </footer>
