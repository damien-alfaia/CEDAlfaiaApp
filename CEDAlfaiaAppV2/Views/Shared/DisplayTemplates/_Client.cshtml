@model CEDAlfaiaAppV2.Models.DisplayClient

@{
    if (this.Model != null)
    {
        <i class="fa fa-user"></i>
        <span>
            @(this.Model.Client.Nom)
        </span>
        <br/>
        <span class="text-muted">
            @(" - " + this.Model.Client.Telephone)
        </span>
    }
}
