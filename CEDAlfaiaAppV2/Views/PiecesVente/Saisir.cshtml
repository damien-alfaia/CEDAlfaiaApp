@model CEDAlfaiaAppV2.Models.SaisirPieceVenteModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script>
    function gridBox_valueChanged(e) {
        var $dropDownBox = $("#dropDownBoxClient");
        if ($dropDownBox.length) {
            var dropDownBoxClient = $dropDownBox.dxDropDownBox("instance");
            if (e.value[0] !== undefined)
                dropDownBoxClient.option("value", e.value[0].ID);
        }
    }

    function gridBox_displayExpr(item) {
        return item && item.Libelle;
    }

    function mainDOeuvreOnChange() {
        var duree = $("#DureeMainDOeuvre").dxNumberBox("instance").option("value");
        var mainDOeuvre = $("#MainDOeuvre").dxNumberBox("instance").option("value");

        $("#TotalMainDOeuvre").dxNumberBox("instance").option("value", duree * mainDOeuvre);
        updatePiedFacture();
        //piedFactureOnChange();
    }

    function CreateInputLigne(itemName, itemValue, itemIndex, container) {
        var $input = $("<input />");

        $input.appendTo(container).attr({ type: "hidden", name: "Lignes[" + itemIndex + "]." + itemName }).val(itemValue);
    }
    function CreateInputPaiement(itemName, itemValue, itemIndex, container) {
        var $input = $("<input />");

        $input.appendTo(container).attr({ type: "hidden", name: "Paiements[" + itemIndex + "]." + itemName }).val(itemValue);
    }
    function clickHandler(e) {

        if (e.validationGroup.validate().isValid) {
            if ($("#gridLignes").dxDataGrid('instance') !== undefined) {
                var items = $("#gridLignes").dxDataGrid('instance')._controllers.data._dataSource._items;
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    for (var property in item) {
                        if (item.hasOwnProperty(property)) {
                            CreateInputLigne(property, item[property], i, $("#editPieceVente")[0]);
                        }
                    }
                }
            }
            if ($("#gridPaiements").dxDataGrid('instance') !== undefined) {
                var itemsPaiements = $("#gridPaiements").dxDataGrid('instance')._controllers.data._dataSource._items;
                for (var i = 0; i < itemsPaiements.length; i++) {
                    var item = itemsPaiements[i];
                    for (var property in item) {
                        if (item.hasOwnProperty(property)) {
                            var value = item[property];
                            if (property == 'Date') {
                                value = formaterDate(value);
                            }
                            CreateInputPaiement(property, value, i, $("#editPieceVente")[0]);
                        }
                    }
                }
            }
            $("#editPieceVente")[0].submit();
        }
    }

    function editorPrepared(e) {
        if (e.dataField != 'Libelle') {
            e.editorElement.dxNumberBox('instance').option('onValueChanged', args => {
                setRowLigne(e.row, e.dataField, args.value);
            });
        }
        //$("#gridLignes").dxDataGrid("instance").cellValue(e.row.rowIndex, "Libelle", "test");
    }

    function setRowLigne(row, typeSaisie, valeur) {
        if (row !== undefined && typeSaisie !== undefined && valeur !== undefined) {
            var quantite = parseFloat(typeSaisie == 'Quantite' ? valeur : row.data.Quantite);
            var remise = parseFloat(typeSaisie == 'Remise' ? valeur : row.data.Remise);
            var prixGarageHT = parseFloat(typeSaisie == 'PrixGarageHT' ? valeur : (row.data.PrixGarageHT !== undefined && row.data.PrixGarageHT != null ? row.data.PrixGarageHT : 0));
            var prixGarageTTC = parseFloat(typeSaisie == 'PrixGarageTTC' ? valeur : (row.data.PrixGarageTTC !== undefined && row.data.PrixGarageTTC != null ? row.data.PrixGarageTTC : 0));
            var prixClientHT = parseFloat(typeSaisie == 'PrixClientHT' ? valeur : (row.data.PrixClientHT !== undefined && row.data.PrixClientHT != null ? row.data.PrixClientHT : 0));
            var prixClientTTC = parseFloat(typeSaisie == 'PrixClientTTC' ? valeur : (row.data.PrixClientTTC !== undefined && row.data.PrixClientTTC != null ? row.data.PrixClientTTC : 0));

            row.data.Quantite = parseFloat(quantite);
            row.data.Remise = parseFloat(remise);
            switch (typeSaisie) {
                /*
                case 'Remise':
                    prixClientHT = prixGarageHT / (1 - remise / 100);
                    prixClientTTC = prixGarageTTC / (1 - remise / 100);
                    break;
                case 'PrixGarageHT':
                    prixGarageTTC = prixGarageHT * 1.2;
                    prixClientHT = prixGarageHT / (1 - remise / 100);
                    prixClientTTC = prixGarageTTC / (1 - remise / 100);
                    break;
                case 'PrixGarageTTC':
                    prixGarageHT = prixGarageTTC / 1.2;
                    prixClientHT = prixGarageHT / (1 - remise / 100);
                    prixClientTTC = prixGarageTTC / (1 - remise / 100);
                    break;
                case 'PrixClientHT':
                    prixClientTTC = prixClientHT * 1.2;
                    prixGarageHT = prixClientHT - (prixClientHT * (remise / 100));
                    prixGarageTTC = prixClientTTC - (prixClientTTC * (remise / 100));
                    break;
                case 'PrixClientTTC':
                    prixClientHT = prixClientTTC / 1.2;
                    prixGarageHT = prixClientHT - (prixClientHT * (remise / 100));
                    prixGarageTTC = prixClientTTC - (prixClientTTC * (remise / 100));
                    break;
                */
                case 'Remise':
                    prixClientHT = prixGarageTTC / (1 - remise / 100);
                    prixClientTTC = prixClientHT;
                    break;
                case 'PrixGarageHT':
                    prixGarageTTC = prixGarageHT * 1.2;
                    prixClientHT = prixGarageTTC / (1 - remise / 100);
                    prixClientTTC = prixClientHT;
                    break;
                case 'PrixGarageTTC':
                    prixGarageHT = prixGarageTTC / 1.2;
                    prixClientHT = prixGarageTTC / (1 - remise / 100);
                    prixClientTTC = prixClientHT;
                    break;
                case 'PrixClientHT':
                    prixClientTTC = prixClientHT;
                    prixGarageTTC = prixClientHT - (prixClientHT * (remise / 100));
                    prixGarageHT = prixGarageTTC / 1.2;
                    break;
                case 'PrixClientTTC':
                    prixClientHT = prixClientTTC;
                    prixGarageTTC = prixClientHT - (prixClientHT * (remise / 100));
                    prixGarageHT = prixGarageTTC / 1.2;
                    break;
            }

            row.data.PrixGarageHT = prixGarageHT;
            row.data.PrixGarageTTC = prixGarageTTC;
            row.data.PrixClientHT = prixClientHT;
            row.data.PrixClientTTC = prixClientTTC;
            row.data.TotalPrixGarageTTC = prixGarageTTC * quantite;
            row.data.TotalPrixClientTTC = prixClientTTC * quantite;
        }
        $("#gridLignes").dxDataGrid('instance').refresh();
    }

    function formaterDate(date) {
        var month = date.getMonth() + 1,
            day = date.getDate(),
            year = date.getFullYear();
        return day + "/" + month + "/" + year;
    }

    function parserDate(e) {
        var parts = e.split("/"),
            day = Number(parts[0]),
            month = Number(parts[1] - 1),
            year = Number(parts[2]);
        return new Date(year, month, day);
    }

    function updatePiedFacture() {
        try {
            var totalHTLignes = $("#gridLignes").dxDataGrid('instance').getTotalSummaryValue("TotalPrixClientTTC") / 1/*.2*/;
            var totalMainDOeuvre = $("#TotalMainDOeuvre").dxNumberBox("instance")._parsedValue / 1/*.2*/;
            var remise = $("#inputRemise").dxNumberBox("instance").option("value");

            var totalHT = (totalHTLignes + totalMainDOeuvre) - ((totalHTLignes + totalMainDOeuvre) * remise);
            var totalTTC = totalHT * 1/*.2*/;
            var montantTVA = totalTTC - totalHT;

            $("#TotalTTC").dxNumberBox("instance").option("value", totalTTC);
            $("#TotalHT").dxNumberBox("instance").option("value", totalHT);
            $("#MontantTVA").dxNumberBox("instance").option("value", montantTVA);
        }
        catch (ex) {

        }
    }


    $(document).ready(function () {
        mainDOeuvreOnChange();
        $(".dx-tab")[1].click();
        $(".dx-tab")[0].click();
        //updatePiedFacture();
    });
</script>


@{
    string titleFormulaire = "Nouvelle facture";
    if (this.Model != null && this.Model.IDPieceVente > 0)
    {
        titleFormulaire = this.Model.TypePiece + " " + this.Model.Numero;
    }
    else if (this.Model != null && this.Model.TypePiece == "Devis")
    {
        titleFormulaire = "Nouveau devis";
    }
    ViewBag.Title = titleFormulaire;

    List<CEDAlfaiaAppV2.Models.ValeurLibelle> typesPaiement = new List<CEDAlfaiaAppV2.Models.ValeurLibelle>();
    foreach (CEDAlfaiaApp.DAL.Garage.TypePaiement typePaiement in Enum.GetValues(typeof(CEDAlfaiaApp.DAL.Garage.TypePaiement)))
    {
        typesPaiement.Add(new CEDAlfaiaAppV2.Models.ValeurLibelle((int)typePaiement, typePaiement.ToString()));
    }

    var designations = CEDAlfaiaApp.BLL.CEDAlfaiaAppWebService.GetService().GarageService.GetAllDesignations().Distinct().Select(s => new { designation = s }).ToList();
}

