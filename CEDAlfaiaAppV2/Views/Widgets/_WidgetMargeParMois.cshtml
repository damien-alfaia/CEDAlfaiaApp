@model CEDAlfaiaApp.DAL.Widgets.WidgetUtilisateur


@{
    var factures = CEDAlfaiaApp.BLL.CEDAlfaiaAppWebService.GetService().GarageService.Factures().Where(f => !f.IsFactureAnnule).ToList();
    if (this.Model.DateDebut != null || this.Model.DateFin != null)
    {
        if (this.Model.DateDebut != null)
        {
            factures = factures.Where(f => f.DateFacture >= this.Model.DateDebut).ToList();
        }
        if (this.Model.DateFin != null)
        {
            factures = factures.Where(f => f.DateFacture <= this.Model.DateFin).ToList();
        }
    }
    else if (this.Model.IsAnneeEnCours != null && this.Model.IsAnneeEnCours.Value)
    {
        factures = factures.Where(f => f.DateFacture.Value.Year == DateTime.Now.Year).ToList();
    }
    else if (this.Model.IsMoisEnCours != null && this.Model.IsMoisEnCours.Value)
    {
        factures = factures.Where(f => f.DateFacture.Value.Year == DateTime.Now.Year && f.DateFacture.Value.Month == DateTime.Now.Month).ToList();
    }

    var gp = factures.GroupBy(
            g => g.DateFacture.Value.ToString("MM/yyyy"),
            g => g,
            (key, g) => new { MoisAnnee = key, Marge = g.Sum(f => f.CalculerBeneficeTTC()) }).OrderBy(d => d.MoisAnnee).ToList();
}

@(Html.DevExtreme().Chart()
    .ID("widgetMargeParMois" + this.Model.ID)
    .Palette(VizPalette.Carmine)
    .CommonSeriesSettings(s => s
        .ArgumentField("MoisAnnee")
        .Type(SeriesType.Line)
    )
    .Size(s => s.Width(new JS("$('#" + this.Model.HtmlOwnerZoneUID + "').width() - 30")).Height(300))
    .ArgumentAxis(a => a
        .ValueMarginsEnabled(false)
        .DiscreteAxisDivisionMode(DiscreteAxisDivisionMode.CrossLabels)
        .Grid(g => g.Visible(true))
    )
    .Series(s =>
    {
        s.Add().ValueField("Marge").Name("Marge par mois");
    })
    .Legend(l => l
        .VerticalAlignment(VerticalEdge.Bottom)
        .HorizontalAlignment(HorizontalAlignment.Center)
        .ItemTextPosition(Position.Bottom)
    )
    .Title(t => t
        .Text("Marge par mois")
    )
    .Export(e => e.Enabled(true))
    .Tooltip(t => t
        .Enabled(true)
        .CustomizeTooltip(@<text>
            function (arg) {
            return {
            text: arg.valueText
            };
            }
        </text>)
    )
    .DataSource(gp)
)