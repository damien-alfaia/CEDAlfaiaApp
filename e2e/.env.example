# =============================================================================
# Variables pour les tests Playwright
# =============================================================================
# Copier vers e2e/.env (gitignored) et remplir.
# Sans E2E_USER_EMAIL / E2E_USER_PASSWORD, seuls les tests publics tournent.
# =============================================================================

# URL de l'app (par défaut http://localhost:3000)
E2E_BASE_URL=http://localhost:3000

# Compte de test (créer un user dédié sur staging via le dashboard Auth,
# avec "Auto Confirm User" coché pour bypass la confirmation email).
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Code d'inscription (pour tester le flux signup uniquement,
# avec un autre email à chaque run — facultatif).
E2E_SIGNUP_CODE=
